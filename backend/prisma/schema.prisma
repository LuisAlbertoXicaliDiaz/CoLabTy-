generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Tablas de CoLabTy ---

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boards      Board[]     // Tableros creados por el usuario
  userBoards  UserBoard[] // Tableros donde ha sido invitado
}

model Board {
  id        String   @id @default(uuid())
  title     String   
  createdAt DateTime @default(now())
  
  userId    Int      // Creador original del tablero
  user      User     @relation(fields: [userId], references: [id])
  
  columns   Column[] 
  members   UserBoard[] // Miembros invitados al tablero
}

model Column {
  id        String   @id @default(uuid())
  title     String   
  order     Int      
  
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  
  tasks     Task[]   
}

model Task {
  id        String   @id @default(uuid())
  content   String   
  order     Int      
  priority  String   @default("media") // "baja", "media", "alta"
  dueDate   String?  // Fecha límite opcional (formato YYYY-MM-DD)
  
  columnId  String
  column    Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
}

// Tabla intermedia para la relación de muchos a muchos (Colaboradores)
model UserBoard {
  id      Int    @id @default(autoincrement())
  userId  Int
  boardId String
  status  String @default("pending") // "pending" o "accepted"
  
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([userId, boardId])
}